#!/usr/bin/env sh
#
# Refuse a push that would leave the app unbuildable in the cloud — see
# app/scripts/check-core-stack.mjs for what "unbuildable" means and why.
#
# Installed by `bun install` (the app's `prepare` script points core.hooksPath here),
# so a fresh clone gets it as soon as dependencies are installed.
#
# Fails OPEN: if there is no JS runtime to run the check with, a push is allowed with
# a warning. Blocking someone's push because their machine lacks bun/node would be a
# worse failure than the one this guards against.

runtime=""
for candidate in bun node; do
  if command -v "$candidate" >/dev/null 2>&1; then
    runtime="$candidate"
    break
  fi
done

if [ -z "$runtime" ]; then
  echo "pre-push: neither bun nor node found — skipping the core-stack check" >&2
  exit 0
fi

checker="app/scripts/check-core-stack.mjs"
[ -f "$checker" ] || exit 0  # nothing to enforce (older app, or not the app repo)

# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed.
# Check each commit actually being sent, not the working tree — the working tree can
# be clean while the commit on its way out is the one that gutted the stack.
zero="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue  # a branch deletion pushes no content
  if ! "$runtime" "$checker" --ref "$local_sha"; then
    status=1
  fi
done

exit $status
